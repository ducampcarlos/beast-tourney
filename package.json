{
  "name": "beast-tourney",
  "version": "0.1.0",
  "private": true,
  "description": "A fantasy creature auto-battler for the browser: buy, merge and bond a team of beasts, then watch them fight their way through a 12-round tournament.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "author": "Carlos Ducamp",
  "repository": { "type": "git", "url": "git+https://github.com/ducampcarlos/beast-tourney.git" },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "balance": "node --import tsx src/sim/balance.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
